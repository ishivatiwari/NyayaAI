# NyayaAI Environment Variables
# Copy this file to .env and fill in your values

# ────────────────────────────────────
# APPLICATION
# ────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production

# ────────────────────────────────────
# AI PROVIDER
# ────────────────────────────────────
# Primary AI provider: gemini | openai | azure
LLM_PROVIDER=gemini

# Google Gemini (recommended)
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-gemini-api-key-here

# OpenAI (fallback, optional)
# OPENAI_API_KEY=your-openai-api-key-here

# ────────────────────────────────────
# MODEL CONFIGURATION
# ────────────────────────────────────
LLM_MODEL=gemini-1.5-pro
EMBEDDING_MODEL=models/text-embedding-004

# ────────────────────────────────────
# DATABASE
# ────────────────────────────────────
# SQLite for development (zero config)
DATABASE_URL=sqlite+aiosqlite:///./nyayaai.db

# PostgreSQL for production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/nyayaai

# ────────────────────────────────────
# VECTOR STORE
# ────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=nyayaai_documents

# ────────────────────────────────────
# STORAGE
# ────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# ────────────────────────────────────
# CORS
# ────────────────────────────────────
# Add your frontend URL
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ────────────────────────────────────
# DEMO MODE
# ────────────────────────────────────
# Set to true to run without API keys (simulated responses)
DEMO_MODE=false
